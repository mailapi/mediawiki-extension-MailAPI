{
    "name": "jmnote/mail-api",
    "type": "mediawiki-extension",
    "description": "Sends MediaWiki user email through Mail API.",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "jmnote"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "MediaWiki\\Extension\\MailAPI\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MediaWiki\\Extension\\MailAPI\\Tests\\": "tests/phpunit/"
        }
    }
}
